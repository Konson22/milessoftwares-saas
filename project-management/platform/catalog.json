    "separation_of_duties": [
        {
            "permissions": [
                "projects.expenses.request",
                "finance.expenses.approve"
            ],
            "mode": "warn",
            "description": "Whoever requests spending never approves it (enforced per request too)."
        },
        {
            "permissions": [
                "finance.expenses.approve",
                "finance.payments.record"
            ],
            "mode": "warn",
            "description": "Approving and paying the same spending."
        },
        {
            "permissions": ["procurement.request", "procurement.approve"],
            "mode": "warn",
            "description": "Asking to buy and approving the purchase."
        }
    ]
}
