APP_NAME="Projects"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Served in each workspace at {slug}.milesoftwares.localhost/projects. Routes
# carry /projects themselves. APP_URL is the host only (no path), so
# console/queue URLs do not double the prefix.
APP_URL=http://milesoftwares.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The app's own database: project data, and copies of the platform's
# users, organizations and memberships keyed by the platform's ids.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=projects
DB_USERNAME=
DB_PASSWORD=

# Session cookie of this product only, on its own path.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=miles_projects_session
SESSION_PATH=/projects
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=projects

# Addresses of reverse proxies that may set X-Forwarded-Proto / Host.
TRUSTED_PROXIES=127.0.0.1

# Email: alerts, digests and donors' invitations to the organizations they fund.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="projects@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# How long someone added as a funder's contact has to open Projects.
INVITATION_DAYS=30

# Platform connection (miles/platform-client). Locally, written by:
#   cd central-app && php artisan platform:local-product project-management --url=http://127.0.0.1:9300 --entitle=<slug>
PLATFORM_APPLICATION=projects
# Optional path on workspace hosts; defaults to PLATFORM_APPLICATION.
PLATFORM_PATH=
PLATFORM_ROOT_DOMAIN=milesoftwares.localhost
PLATFORM_ISSUER=http://auth.milesoftwares.localhost
PLATFORM_BACKCHANNEL_URL=http://127.0.0.1:8101
PLATFORM_SIGN_IN_CLIENT_ID=
PLATFORM_SIGN_IN_CLIENT_SECRET=
PLATFORM_SERVICE_CLIENT_ID=
PLATFORM_SERVICE_CLIENT_SECRET=
PLATFORM_WEBHOOK_SECRET=
# Finance (shared module): paid project spending, grant payments, petty
# cash and staff advances go here when set, e.g.
# http://127.0.0.1:8500/finance/events locally.
PLATFORM_FINANCE_EVENTS_URL=
PLATFORM_CSP=true
PLATFORM_HSTS=false

# Vite dev server address when the platform hosts resolve to a LAN IP.
DEV_SERVER_HOST=
DEV_SERVER_PORT=
DEV_SERVER_PUBLIC_HOST=
