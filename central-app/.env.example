APP_NAME="Miles Global Softwares"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://milessoftwares.localhost:8100
SERVER_PORT=8100

PLATFORM_ROOT_DOMAIN=milessoftwares.localhost

# First-party OIDC clients for app. and admin. (php artisan platform:oidc-clients --write-env).
# Locally, `composer dev` serves the token endpoint on 127.0.0.1:8101 because
# `php artisan serve` on Windows cannot call itself; leave empty in production.
PLATFORM_OIDC_BACKCHANNEL_URL=http://127.0.0.1:8101
PLATFORM_APP_CLIENT_ID=
PLATFORM_APP_CLIENT_SECRET=
PLATFORM_ADMIN_CLIENT_ID=
PLATFORM_ADMIN_CLIENT_SECRET=
PLATFORM_WORKSPACE_CLIENT_ID=
PLATFORM_WORKSPACE_CLIENT_SECRET=

# Where demo requests and contact messages are sent (defaults to MAIL_FROM_ADDRESS).
PLATFORM_SALES_EMAIL=

# Security headers. Production: HSTS on once every host has a valid certificate
# (docs/runbooks/dns-tls.md); `php artisan platform:preflight` checks these.
PLATFORM_CSP=true
PLATFORM_CSP_REPORT_ONLY=false
PLATFORM_CSP_REPORT_URI=
PLATFORM_HSTS=false
PLATFORM_HSTS_MAX_AGE=63072000

# Load balancer addresses or CIDR ranges allowed to set X-Forwarded-* (never *).
TRUSTED_PROXIES=

# Off-site audit export (platform:audit-export). Production: s3 with Object Lock.
AUDIT_EXPORT_DRIVER=local
AUDIT_EXPORT_BUCKET=
AUDIT_EXPORT_REGION=
AUDIT_EXPORT_KEY=
AUDIT_EXPORT_SECRET=
AUDIT_EXPORT_ENDPOINT=
AUDIT_EXPORT_PATH_STYLE=false

# queue:monitor logs a critical line above this many waiting jobs.
QUEUE_MONITOR_MAX=500

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=miles_platform
DB_USERNAME=miles
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true and
# SESSION_COOKIE=__Host-miles-session (host-only; see docs/production-checklist.md).

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite dev server address, when the platform hosts resolve to a LAN IP instead of
# loopback (browsers block LAN pages from loading loopback assets). Optional.
DEV_SERVER_HOST=
DEV_SERVER_PORT=

VITE_APP_NAME="${APP_NAME}"
