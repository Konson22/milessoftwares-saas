{
    "application": {
        "code": "restaurant",
        "name": "Restaurant",
        "category": "products",
        "kind": "standalone",
        "status": "planned"
    },
    "version": "1.0.0",
    "roles": [
        {
            "key": "manager",
            "name": "Restaurant Manager",
            "sensitivity": 3,
            "delegable": true,
            "scopes": ["organization", "branch"],
            "permissions": [
                "restaurant.menu.view",
                "restaurant.menu.manage",
                "restaurant.tables.manage",
                "restaurant.orders.take",
                "restaurant.orders.void",
                "restaurant.kitchen.view",
                "restaurant.bills.view",
                "restaurant.bills.take",
                "restaurant.bills.void",
                "restaurant.tills.manage",
                "restaurant.stock.view",
                "restaurant.stock.adjust"
            ]
        },
        {
            "key": "cashier",
            "name": "Cashier",
            "sensitivity": 2,
            "delegable": true,
            "scopes": ["organization", "branch"],
            "permissions": [
                "restaurant.menu.view",
                "restaurant.orders.take",
                "restaurant.bills.view",
                "restaurant.bills.take"
            ]
        },
        {
            "key": "waiter",
            "name": "Waiter",
            "sensitivity": 1,
            "delegable": true,
            "scopes": ["organization", "branch"],
            "permissions": ["restaurant.menu.view", "restaurant.orders.take"]
        },
        {
            "key": "kitchen",
            "name": "Kitchen",
            "sensitivity": 1,
            "delegable": true,
            "scopes": ["organization", "branch"],
            "permissions": ["restaurant.menu.view", "restaurant.kitchen.view"]
        }
    ],
    "permissions": [
        {
            "key": "restaurant.menu.view",
            "name": "View the menu",
            "sensitivity": 1,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "restaurant.menu.manage",
            "name": "Add and change dishes, drinks and prices",
            "sensitivity": 2,
            "scopes": ["organization"]
        },
        {
            "key": "restaurant.tables.manage",
            "name": "Set up dining areas and tables",
            "sensitivity": 2,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "restaurant.orders.take",
            "name": "Take table and takeaway orders and send them to the kitchen",
            "sensitivity": 1,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "restaurant.orders.void",
            "name": "Void dishes already sent to the kitchen and cancel orders",
            "sensitivity": 3,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "restaurant.kitchen.view",
            "name": "Work the kitchen screen: tickets ready and served",
            "sensitivity": 1,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "restaurant.bills.view",
            "name": "View paid bills",
            "sensitivity": 1,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "restaurant.bills.take",
            "name": "Take payment for bills into your own till",
            "sensitivity": 2,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "restaurant.bills.void",
            "name": "Void paid bills and refund them",
            "sensitivity": 3,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "restaurant.tills.manage",
            "name": "See and close every cashier's till",
            "sensitivity": 3,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "restaurant.stock.view",
            "name": "View stock of drinks",
            "sensitivity": 1,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "restaurant.stock.adjust",
            "name": "Record opening stock and stock counts",
            "sensitivity": 3,
            "scopes": ["organization", "branch"]
        }
    ],
    "separation_of_duties": [
        {
            "permissions": ["restaurant.bills.take", "restaurant.bills.void"],
            "mode": "warn",
            "description": "Voiding bills you took payment for yourself needs a second look."
        },
        {
            "permissions": ["restaurant.orders.take", "restaurant.orders.void"],
            "mode": "warn",
            "description": "Voiding dishes you ordered yourself needs a second look."
        },
        {
            "permissions": ["restaurant.bills.take", "restaurant.stock.adjust"],
            "mode": "warn",
            "description": "One person selling and adjusting stock can hide shortages."
        }
    ]
}
