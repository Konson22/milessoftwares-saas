# Inertia server-side rendering for the public site, on 127.0.0.1:13714 only.
[Unit]
Description=Miles platform SSR server
After=network-online.target

[Service]
User=miles
Group=miles
WorkingDirectory=/srv/miles/current/central-app
ExecStart=/usr/bin/php /srv/miles/current/central-app/artisan inertia:start-ssr
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
