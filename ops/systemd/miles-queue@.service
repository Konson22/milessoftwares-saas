# Queue workers. Enable several: systemctl enable --now miles-queue@{1..3}
# `php artisan queue:restart` (run by deploy.sh) makes them exit after the
# current job; systemd starts them again on the new release.
[Unit]
Description=Miles platform queue worker %i
After=network-online.target redis-server.service postgresql.service

[Service]
User=miles
Group=miles
WorkingDirectory=/srv/miles/current/central-app
ExecStart=/usr/bin/php /srv/miles/current/central-app/artisan queue:work redis --sleep=1 --tries=3 --max-time=3600 --memory=256
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
