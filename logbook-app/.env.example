APP_NAME="Miles Logbook"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Routes carry /logbook themselves. APP_URL is the host only (no path),
# so console/queue URLs do not double the prefix.
APP_URL=http://tatook.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Each product has its own database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=logbook
DB_USERNAME=miles
DB_PASSWORD=

# The product shares the workspace host with the platform: its cookies are
# its own (name and path), so they never collide with the workspace's.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=miles_logbook_session
SESSION_PATH=/logbook
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=logbook

# Addresses of reverse proxies that may set X-Forwarded-Proto / Host.
TRUSTED_PROXIES=127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Platform connection (miles/platform-client). Locally, written by:
#   cd central-app && php artisan platform:local-product <folder> --entitle=<slug>
PLATFORM_APPLICATION=logbook
# Optional path on workspace hosts; defaults to PLATFORM_APPLICATION.
PLATFORM_PATH=
PLATFORM_ROOT_DOMAIN=tatook.localhost
PLATFORM_ISSUER=http://auth.tatook.localhost
PLATFORM_BACKCHANNEL_URL=http://127.0.0.1:8101
PLATFORM_SIGN_IN_CLIENT_ID=
PLATFORM_SIGN_IN_CLIENT_SECRET=
PLATFORM_SERVICE_CLIENT_ID=
PLATFORM_SERVICE_CLIENT_SECRET=
PLATFORM_WEBHOOK_SECRET=
# The phone app's public client (logbook-mobile-app, ADR-0025 §8).
PLATFORM_MOBILE_CLIENT_ID=
# Shared modules this product sends events to (outbox; retried every minute).
PLATFORM_FINANCE_EVENTS_URL=
PLATFORM_CSP=true
PLATFORM_HSTS=false

# Vite dev server address when the platform hosts resolve to a LAN IP.
DEV_SERVER_HOST=
DEV_SERVER_PORT=
DEV_SERVER_PUBLIC_HOST=

VITE_APP_NAME="${APP_NAME}"

# Phone notifications (ADR-0027): off until the Firebase project and FCM key exist.
LOGBOOK_PUSH_ENABLED=false
# Only when push security is enabled in the Expo account.
LOGBOOK_EXPO_ACCESS_TOKEN=

# GPS routes (ADR-0028): days a route is kept after it ends; map tiles for the route viewer.
LOGBOOK_TRACK_RETENTION_DAYS=730
LOGBOOK_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
LOGBOOK_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
