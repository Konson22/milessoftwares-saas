APP_NAME="Pharmacy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Routes carry /pharmacy themselves. APP_URL is the host only (no path),
# so console/queue URLs do not double the prefix.
APP_URL=http://milessoftwares.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Each product has its own database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pharmacy
DB_USERNAME=miles
DB_PASSWORD=

# The product shares the workspace host with the platform: its cookies are
# its own (name and path), so they never collide with the workspace's.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=miles_pharmacy_session
SESSION_PATH=/pharmacy
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=pharmacy

# Addresses of reverse proxies that may set X-Forwarded-Proto / Host.
TRUSTED_PROXIES=127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Platform connection (miles/platform-client). Locally, written by:
#   cd central-app && php artisan platform:local-product <folder> --entitle=<slug>
PLATFORM_APPLICATION=pharmacy
# Optional path on workspace hosts; defaults to PLATFORM_APPLICATION.
PLATFORM_PATH=
PLATFORM_ROOT_DOMAIN=milessoftwares.local
PLATFORM_ISSUER=http://auth.milessoftwares.local
PLATFORM_BACKCHANNEL_URL=http://127.0.0.1:8101
PLATFORM_SIGN_IN_CLIENT_ID=
PLATFORM_SIGN_IN_CLIENT_SECRET=
PLATFORM_SERVICE_CLIENT_ID=
PLATFORM_SERVICE_CLIENT_SECRET=
PLATFORM_WEBHOOK_SECRET=
# Shared modules this product sends events to (outbox; retried every minute).
PLATFORM_FINANCE_EVENTS_URL=
PLATFORM_CSP=true
PLATFORM_HSTS=false

# Vite dev server address when the platform hosts resolve to a LAN IP.
DEV_SERVER_HOST=
DEV_SERVER_PORT=

VITE_APP_NAME="${APP_NAME}"
