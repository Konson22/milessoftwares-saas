{
  "expo": {
    "name": "Mataem Plus",
    "slug": "mataem-plus",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "com.milesoftwares.restaurant",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.milesoftwares.restaurant"
    },
    "android": {
      "package": "com.milesoftwares.restaurant",
      "adaptiveIcon": {
        "backgroundColor": "#8F0101",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3A0701",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "944e4ec8-20ae-48d2-813a-ec279483edb9"
      }
    },
    "owner": "konsonaks-team"
  }
}
