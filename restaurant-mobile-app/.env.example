# Online mode: the platform's sign-in and the workspaces' restaurant.
# Offline mode (the restaurant on this phone) needs none of these.

# The platform's auth host (OpenID provider).
EXPO_PUBLIC_AUTH_URL=https://auth.milesoftwares.com

# The app's public client: PLATFORM_MOBILE_CLIENT_ID in restaurant-app/.env.
EXPO_PUBLIC_CLIENT_ID=

# A workspace's address; {workspace} is its slug.
EXPO_PUBLIC_WORKSPACE_URL=https://{workspace}.milesoftwares.com

# The restaurant's path on workspace hosts.
EXPO_PUBLIC_PRODUCT_PATH=restaurant

# Local development on a phone: where the app's own calls go (with the
# workspace host in the Host header), e.g. http://127.0.0.1 with
# `adb reverse tcp:80 tcp:80`.
EXPO_PUBLIC_DEV_SERVER=

# Native Google sign-in (Google Cloud → Credentials), no browser. The web
# client's ID is the platform's GOOGLE_CLIENT_ID. Android also needs an Android
# client for package com.milesoftwares.restaurant with the SHA-1 of each
# signing key (debug, EAS upload, Play App Signing). Unset: the browser button
# stays instead.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client (bundle com.milesoftwares.restaurant), e.g. 1234-abcd.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
