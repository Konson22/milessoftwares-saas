{
    "application": {
        "code": "payroll",
        "name": "Payroll",
        "category": "products",
        "kind": "shared_module",
        "status": "beta"
    },
    "version": "1.0.0",
    "permissions": [
        {
            "key": "payroll.employees.view",
            "name": "View who is on the payroll",
            "description": "Names, numbers, jobs, branches and departments. No pay.",
            "sensitivity": 1,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "payroll.employees.manage",
            "name": "Add people to the payroll and change their work details",
            "sensitivity": 2,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "payroll.pay.view",
            "name": "View pay and payslips",
            "description": "Basic pay, allowances, deductions, payslips and the account each person is paid into.",
            "sensitivity": 4,
            "scopes": ["organization"]
        },
        {
            "key": "payroll.pay.manage",
            "name": "Change pay, allowances, deductions and payment details",
            "sensitivity": 4,
            "scopes": ["organization"]
        },
        {
            "key": "payroll.settings",
            "name": "Set up allowances, deductions, income tax and social security",
            "sensitivity": 3,
            "scopes": ["organization"]
        },
        {
            "key": "payroll.runs.prepare",
            "name": "Prepare payroll runs",
            "sensitivity": 4,
            "scopes": ["organization"]
        },
        {
            "key": "payroll.runs.approve",
            "name": "Approve payroll runs",
            "description": "Never a run one prepared. Approval locks the run and sends the journal to Finance.",
            "sensitivity": 4,
            "scopes": ["organization"]
        },
        {
            "key": "payroll.runs.pay",
            "name": "Record that a payroll was paid",
            "sensitivity": 4,
            "scopes": ["organization"]
        }
    ],
    "roles": [
        {
            "key": "payroll_clerk",
            "name": "Payroll clerk",
            "description": "Keeps the list of people on the payroll. No pay.",
            "sensitivity": 2,
            "delegable": true,
            "scopes": ["organization", "branch"],
            "permissions": [
                "payroll.employees.view",
                "payroll.employees.manage"
            ]
        },
        {
            "key": "payroll_officer",
            "name": "Payroll officer",
            "description": "Keeps pay up to date and prepares each month's payroll. Cannot approve it.",
            "sensitivity": 4,
            "delegable": false,
            "scopes": ["organization"],
            "permissions": [
                "payroll.employees.view",
                "payroll.employees.manage",
                "payroll.pay.view",
                "payroll.pay.manage",
                "payroll.runs.prepare"
            ]
        },
        {
            "key": "payroll_approver",
            "name": "Payroll approver",
            "description": "Checks and approves prepared payrolls, and records them paid.",
            "sensitivity": 4,
            "delegable": false,
            "scopes": ["organization"],
            "permissions": [
                "payroll.employees.view",
                "payroll.pay.view",
                "payroll.runs.approve",
                "payroll.runs.pay"
            ]
        },
        {
            "key": "payroll_manager",
            "name": "Payroll manager",
            "description": "Everything in Payroll, including income tax and social security rules. Still cannot approve a run they prepared.",
            "sensitivity": 4,
            "delegable": false,
            "scopes": ["organization"],
            "permissions": [
                "payroll.employees.view",
                "payroll.employees.manage",
                "payroll.pay.view",
                "payroll.pay.manage",
                "payroll.settings",
                "payroll.runs.prepare",
                "payroll.runs.approve",
                "payroll.runs.pay"
            ]
        }
    ],
    "separation_of_duties": [
        {
            "permissions": ["payroll.runs.prepare", "payroll.runs.approve"],
            "mode": "warn",
            "description": "Payroll refuses approval by whoever prepared the run; one person holding both still removes a check when nobody else does."
        }
    ]
}
