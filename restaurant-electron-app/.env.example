# The platform's sign-in host (OpenID provider).
VITE_AUTH_URL=https://auth.milesoftwares.com
# The restaurant's public client: restaurant-app's PLATFORM_MOBILE_CLIENT_ID,
# so the restaurant API accepts its tokens. Its redirect URIs must include
# http://127.0.0.1:<VITE_OAUTH_PORT>/oauth
VITE_CLIENT_ID=
VITE_OAUTH_PORT=48218

# A workspace's address; {workspace} is its slug.
VITE_WORKSPACE_URL=https://{workspace}.milesoftwares.com
VITE_PRODUCT_PATH=restaurant
