{
    "application": {
        "code": "blueprint",
        "name": "Blueprint",
        "category": "products",
        "kind": "standalone",
        "status": "beta"
    },
    "version": "1.0.0",
    "permissions": [
        {
            "key": "blueprint.records.view",
            "name": "View records",
            "sensitivity": 1,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "blueprint.records.manage",
            "name": "Add and change records",
            "sensitivity": 2,
            "scopes": ["organization", "branch"]
        }
    ],
    "roles": [
        {
            "key": "viewer",
            "name": "Viewer",
            "sensitivity": 1,
            "delegable": true,
            "scopes": ["organization", "branch"],
            "permissions": ["blueprint.records.view"]
        },
        {
            "key": "editor",
            "name": "Editor",
            "sensitivity": 2,
            "delegable": true,
            "scopes": ["organization", "branch"],
            "permissions": [
                "blueprint.records.view",
                "blueprint.records.manage"
            ]
        }
    ]
}
