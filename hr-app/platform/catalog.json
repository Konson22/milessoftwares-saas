{
    "application": {
        "code": "hr",
        "name": "HR & Payroll",
        "category": "products",
        "kind": "shared_module",
        "status": "planned"
    },
    "version": "1.1.0",
    "permissions": [
        {
            "key": "hr.employees.view",
            "name": "View staff profiles (work details)",
            "description": "Name, job, branch, department, manager, work contacts and employment history. No personal or pay details.",
            "sensitivity": 1,
            "scopes": ["organization", "branch", "department"]
        },
        {
            "key": "hr.employees.manage",
            "name": "Add staff and change work details",
            "sensitivity": 2,
            "scopes": ["organization", "branch", "department"]
        },
        {
            "key": "hr.employment.manage",
            "name": "Record contracts, transfers, promotions and leaving",
            "sensitivity": 3,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "hr.personal.view",
            "name": "View personal details",
            "description": "Identity numbers, date of birth, home address, next of kin and bank details.",
            "sensitivity": 4,
            "scopes": ["organization"]
        },
        {
            "key": "hr.personal.manage",
            "name": "Change personal details",
            "sensitivity": 4,
            "scopes": ["organization"]
        },
        {
            "key": "hr.documents.view",
            "name": "View staff documents",
            "sensitivity": 3,
            "scopes": ["organization", "branch", "department"]
        },
        {
            "key": "hr.documents.manage",
            "name": "Upload and remove staff documents",
            "sensitivity": 3,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "hr.leave.view",
            "name": "View leave",
            "description": "Leave requests and balances of the staff in reach.",
            "sensitivity": 1,
            "scopes": ["organization", "branch", "department"]
        },
        {
            "key": "hr.leave.manage",
            "name": "Record and cancel leave, change leave days",
            "sensitivity": 2,
            "scopes": ["organization", "branch", "department"]
        },
        {
            "key": "hr.leave.approve",
            "name": "Approve or reject leave",
            "description": "Never one's own leave, nor a request one recorded.",
            "sensitivity": 2,
            "scopes": ["organization", "branch", "department"]
        },
        {
            "key": "hr.leave.settings",
            "name": "Set up kinds of leave and public holidays",
            "sensitivity": 3,
            "scopes": ["organization"]
        }
    ],
    "roles": [
        {
            "key": "line_manager",
            "name": "Line manager",
            "description": "Sees the work details of the staff in their branch or department and decides on their leave.",
            "sensitivity": 2,
            "delegable": true,
            "scopes": ["organization", "branch", "department"],
            "permissions": [
                "hr.employees.view",
                "hr.leave.view",
                "hr.leave.approve"
            ]
        },
        {
            "key": "hr_officer",
            "name": "HR officer",
            "description": "Keeps staff records, contracts, documents and leave. No personal or bank details.",
            "sensitivity": 3,
            "delegable": true,
            "scopes": ["organization", "branch"],
            "permissions": [
                "hr.employees.view",
                "hr.employees.manage",
                "hr.employment.manage",
                "hr.documents.view",
                "hr.documents.manage",
                "hr.leave.view",
                "hr.leave.manage",
                "hr.leave.approve"
            ]
        },
        {
            "key": "hr_manager",
            "name": "HR manager",
            "description": "Everything in HR, including personal and bank details.",
            "sensitivity": 4,
            "delegable": false,
            "scopes": ["organization"],
            "permissions": [
                "hr.employees.view",
                "hr.employees.manage",
                "hr.employment.manage",
                "hr.personal.view",
                "hr.personal.manage",
                "hr.documents.view",
                "hr.documents.manage",
                "hr.leave.view",
                "hr.leave.manage",
                "hr.leave.approve",
                "hr.leave.settings"
            ]
        }
    ]
}
