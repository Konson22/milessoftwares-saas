    "separation_of_duties": [
        {
            "permissions": ["petrol.sales.create", "petrol.sales.void"],
            "mode": "warn",
            "description": "Voiding a sale you recorded yourself needs a second look."
        },
        {
            "permissions": ["petrol.sales.create", "petrol.stock.adjust"],
            "mode": "warn",
            "description": "One person selling and adjusting stock can hide shortages."
        },
        {
            "permissions": ["petrol.purchases.manage", "petrol.payables.pay"],
            "mode": "warn",
            "description": "Ordering fuel and paying the supplier should not rest with one person."
        },
        {
            "permissions": ["petrol.shifts.close", "petrol.shifts.approve"],
            "mode": "warn",
            "description": "Approving a closing you submitted needs a second look."
        },
        {
            "permissions": ["petrol.cash.submit", "petrol.cash.confirm"],
            "mode": "warn",
            "description": "The person who hands over cash does not confirm receiving it."
        }
