includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src/
        - routes/
        - database/
        # Models using the tenancy trait, so PHPStan analyses it.
        - tests/Fixtures/Prescription.php
        - tests/Fixtures/User.php
        - tests/Fixtures/ProductTestCase.php

    level: 7
