# "mock" runs a demo pharmacy inside the app; "live" talks to the workspace.
VITE_API_MODE=mock

# The platform's sign-in host (OpenID provider).
VITE_AUTH_URL=https://auth.milesoftwares.com
# The pharmacy's public (mobile) client: the pharmacy API accepts its tokens.
# Its redirect URIs must include http://127.0.0.1:<VITE_OAUTH_PORT>/oauth
VITE_CLIENT_ID=
VITE_OAUTH_PORT=48217

# A workspace's address; {workspace} is its slug.
VITE_WORKSPACE_URL=https://{workspace}.milesoftwares.com
VITE_PRODUCT_PATH=pharmacy

# A shop (Retail) sells from the same app: its public client (pharmacy-app's
# PLATFORM_RETAIL_MOBILE_CLIENT_ID), with the same redirect URI. Empty: the
# app signs in to the pharmacy only.
VITE_RETAIL_CLIENT_ID=
VITE_RETAIL_PATH=retail
