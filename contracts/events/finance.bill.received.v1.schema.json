{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://milesoftwares.com/contracts/events/finance.bill.received.v1.schema.json",
    "title": "finance.bill.received, schema_version 1",
    "description": "A product received goods or services from a supplier and owes them. Finance posts it to payables (and inventory or expense). Amounts are integers in the currency's minor unit.",
    "type": "object",
    "required": ["bill_number", "supplier_name", "currency", "total_minor", "received_on", "lines"],
    "additionalProperties": false,
    "properties": {
        "bill_number": {
            "type": "string",
            "maxLength": 64,
            "description": "The product's own document number (e.g. a goods received note)."
        },
        "supplier_reference": {
            "type": ["string", "null"],
            "maxLength": 128,
            "description": "The supplier's invoice or delivery note number."
        },
        "supplier_name": { "type": "string", "maxLength": 255 },
        "supplier_id": {
            "type": ["string", "null"],
            "maxLength": 64,
            "description": "The product's id for the supplier, stable across bills."
        },
        "branch_id": { "type": ["string", "null"], "format": "uuid" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "total_minor": { "type": "integer", "minimum": 0 },
        "tax_minor": { "type": "integer", "default": 0 },
        "received_on": { "type": "string", "format": "date" },
        "due_on": { "type": ["string", "null"], "format": "date" },
        "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["description", "quantity", "amount_minor"],
                "additionalProperties": false,
                "properties": {
                    "description": { "type": "string", "maxLength": 255 },
                    "quantity": { "type": "number" },
                    "amount_minor": { "type": "integer" },
                    "expense_account": {
                        "type": ["string", "null"],
                        "maxLength": 32,
                        "description": "Where it is posted; inventory when null."
                    }
                }
            }
        }
    }
}
