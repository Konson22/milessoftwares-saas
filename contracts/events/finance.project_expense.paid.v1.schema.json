{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://milesoftwares.com/contracts/events/finance.project_expense.paid.v1.schema.json",
    "title": "finance.project_expense.paid, schema_version 1",
    "description": "Spending paid, usually on a project: Dr the cost category's account (Salaries and wages, Project materials and supplies, Project equipment, Project travel, Subcontracted services or Other expenses), tagged with the project as a dimension, Cr bank, cash, mobile money, or Employee advances when it was paid from a staff advance. Petty cash payments come this way with method cash. Amounts are integers in the currency's minor unit.",
    "type": "object",
    "required": [
        "reference",
        "paid_on",
        "currency",
        "amount_minor",
        "description",
        "category",
        "method"
    ],
    "additionalProperties": false,
    "properties": {
        "reference": {
            "type": "string",
            "maxLength": 64,
            "description": "The product's id for the payment; a void names it."
        },
        "paid_on": {
            "type": "string",
            "format": "date"
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Any currency: Finance converts it at its rate for the day, and the event waits for one."
        },
        "amount_minor": {
            "type": "integer",
            "minimum": 1
        },
        "description": {
            "type": "string",
            "maxLength": 255
        },
        "category": {
            "enum": [
                "labour",
                "materials",
                "equipment",
                "travel",
                "subcontract",
                "other"
            ]
        },
        "method": {
            "enum": [
                "bank_transfer",
                "cash",
                "mobile_money",
                "staff_advance"
            ]
        },
        "supplier": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 255
        },
        "payment_reference": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 255
        },
        "expense_account": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 32,
            "description": "An active expense or asset account's code to post to instead of the category's."
        },
        "project": {
            "type": [
                "object",
                "null"
            ],
            "required": [
                "code"
            ],
            "additionalProperties": false,
            "properties": {
                "code": {
                    "type": "string",
                    "maxLength": 32
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 255
                }
            }
        }
    }
}
