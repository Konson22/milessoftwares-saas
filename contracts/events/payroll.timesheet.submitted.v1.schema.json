{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://milessoftwares.com/contracts/events/payroll.timesheet.submitted.v1.schema.json",
    "title": "payroll.timesheet.submitted, schema_version 1",
    "description": "Hours worked, for Payroll to price. Products send time only; rates and pay are computed inside the Payroll module and never leave it.",
    "type": "object",
    "required": ["employee_reference", "period_start", "period_end", "entries"],
    "additionalProperties": false,
    "properties": {
        "employee_reference": { "type": "string", "maxLength": 64 },
        "period_start": { "type": "string", "format": "date" },
        "period_end": { "type": "string", "format": "date" },
        "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["date", "hours", "kind"],
                "additionalProperties": false,
                "properties": {
                    "date": { "type": "string", "format": "date" },
                    "hours": { "type": "number", "minimum": 0, "maximum": 24 },
                    "kind": {
                        "enum": ["regular", "overtime", "leave", "holiday"]
                    },
                    "branch_id": {
                        "type": ["string", "null"],
                        "format": "uuid"
                    }
                }
            }
        }
    }
}
