{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://milesoftwares.com/contracts/events/projects.finance_transaction.corrected.v1.schema.json",
    "title": "projects.finance_transaction.corrected, schema_version 1",
    "description": "Finance corrected how a payment was posted (account, journal). References only: an amount changes by a reversal and a new payment, never here, so amount_minor is refused. Contract: docs/finance/finance-projects-contract.md.",
    "type": "object",
    "required": [
        "request_id",
        "correlation_id",
        "sequence",
        "journal_reference"
    ],
    "additionalProperties": false,
    "properties": {
        "request_id": {
            "type": "string",
            "format": "uuid"
        },
        "correlation_id": {
            "type": "string",
            "format": "uuid"
        },
        "sequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Finance's count of outcomes for this request, from 1 with no gaps. Projects applies them in order: a gap is answered 503 (retry), an older number 409."
        },
        "payment_id": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 100
        },
        "journal_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "The posting now in force."
        },
        "note": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 255
        }
    }
}
