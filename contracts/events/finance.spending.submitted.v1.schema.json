{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://milessoftwares.com/contracts/events/finance.spending.submitted.v1.schema.json",
    "title": "finance.spending.submitted, schema_version 1",
    "description": "Projects hands approved spending to Finance as a payment request (integrated mode only). Operational approval happened in Projects; Finance accepts or rejects it, approves and pays. Not a journal: nothing is posted until Finance pays. Contract: docs/finance/finance-projects-contract.md.",
    "type": "object",
    "required": [
        "originating_app",
        "organization_id",
        "project_id",
        "request_id",
        "correlation_id",
        "idempotency_key",
        "version",
        "contract_version",
        "currency",
        "amount_minor",
        "created_at",
        "status",
        "project",
        "expense_id",
        "category",
        "description"
    ],
    "additionalProperties": false,
    "properties": {
        "originating_app": {
            "const": "projects"
        },
        "organization_id": {
            "type": "string",
            "format": "uuid"
        },
        "project_id": {
            "type": "string",
            "format": "uuid"
        },
        "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Projects' id for the request: Finance names it in every outcome."
        },
        "correlation_id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable across every message about the request, both ways."
        },
        "idempotency_key": {
            "type": "string",
            "pattern": "^finance-request:[0-9a-f-]{36}:r[0-9]+$",
            "description": "One per request revision: Finance creates at most one payment request per key."
        },
        "version": {
            "type": "integer",
            "minimum": 1,
            "description": "The request revision."
        },
        "contract_version": {
            "const": 1
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "The project currency. Finance converts at its own rates."
        },
        "amount_minor": {
            "type": "integer",
            "minimum": 1,
            "description": "Integer, in the currency's minor unit."
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "status": {
            "const": "submitted"
        },
        "project": {
            "type": "object",
            "required": [
                "id",
                "code",
                "name"
            ],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uuid"
                },
                "code": {
                    "type": "string",
                    "maxLength": 32
                },
                "name": {
                    "type": "string",
                    "maxLength": 255
                }
            }
        },
        "expense_id": {
            "type": "string",
            "format": "uuid"
        },
        "category": {
            "enum": [
                "materials",
                "equipment",
                "travel",
                "subcontract",
                "other"
            ]
        },
        "description": {
            "type": "string",
            "maxLength": 255
        },
        "supplier": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 255
        },
        "grant_reference": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 64
        },
        "approvals": {
            "type": "integer",
            "minimum": 1
        },
        "supersedes_request_id": {
            "type": "string",
            "format": "uuid",
            "description": "On a revision (version > 1): the request it replaces, which Finance refused or whose payment it reversed. Same correlation_id."
        },
        "revision_note": {
            "type": "string",
            "maxLength": 255,
            "description": "On a revision: what changed."
        }
    }
}
