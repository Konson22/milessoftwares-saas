{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://milessoftwares.com/contracts/events/projects.finance_payment.reversed.v1.schema.json",
    "title": "projects.finance_payment.reversed, schema_version 1",
    "description": "Money paid was taken back, in part or in full, for a payment Projects recorded. Contract: docs/finance/finance-projects-contract.md.",
    "type": "object",
    "required": [
        "request_id",
        "correlation_id",
        "sequence",
        "payment_id",
        "amount_minor",
        "currency",
        "organization_id",
        "status"
    ],
    "additionalProperties": false,
    "properties": {
        "organization_id": {
            "type": "string",
            "format": "uuid",
            "description": "The organization, as in the envelope (Projects refuses a mismatch)."
        },
        "request_id": {
            "type": "string",
            "format": "uuid"
        },
        "correlation_id": {
            "type": "string",
            "format": "uuid"
        },
        "sequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Finance's count of outcomes for this request, from 1 with no gaps. Projects applies them in order: a gap is answered 503 (retry), an older number 409."
        },
        "status": {
            "type": "string",
            "enum": [
                "received",
                "prepared",
                "approved",
                "paid",
                "reversed",
                "rejected",
                "cancelled"
            ],
            "description": "Finance's own status for the request after this outcome (authoritative in Finance; Projects keeps its own request status)."
        },
        "finance_reference": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 100,
            "description": "Finance's reference (its payment request number); null until Finance takes the request in."
        },
        "payment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "The payment reversed."
        },
        "amount_minor": {
            "type": "integer",
            "minimum": 1
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "reason": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 255
        },
        "journal_reference": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 100
        }
    }
}
