{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://milesoftwares.com/contracts/events/finance.invoice.issued.v1.schema.json",
    "title": "finance.invoice.issued, schema_version 1",
    "description": "A product issued an invoice or receipt. Finance posts it to receivables/revenue. Amounts are integers in the currency's minor unit.",
    "type": "object",
    "required": ["invoice_number", "currency", "total_minor", "lines"],
    "additionalProperties": false,
    "properties": {
        "invoice_number": { "type": "string", "maxLength": 64 },
        "branch_id": { "type": ["string", "null"], "format": "uuid" },
        "customer_reference": { "type": ["string", "null"], "maxLength": 128 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "total_minor": { "type": "integer" },
        "tax_minor": { "type": "integer", "default": 0 },
        "due_on": { "type": ["string", "null"], "format": "date" },
        "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["description", "quantity", "amount_minor"],
                "additionalProperties": false,
                "properties": {
                    "description": { "type": "string", "maxLength": 255 },
                    "quantity": { "type": "number" },
                    "amount_minor": { "type": "integer" },
                    "revenue_account": {
                        "type": ["string", "null"],
                        "maxLength": 32
                    },
                    "cost_minor": {
                        "type": ["integer", "null"],
                        "minimum": 0,
                        "description": "What the goods on this line cost the seller (stock at cost). Finance moves it from inventory to cost of goods sold. Omit for services."
                    }
                }
            }
        }
    }
}
