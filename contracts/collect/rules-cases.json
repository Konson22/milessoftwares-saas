        },
        {
            "name": "a repeated choice; an empty list is unanswered",
            "form": "wash", "today": "2026-11-15",
            "answers": { "safe_water": "no", "main_source": "vendor", "members": 9, "concerns": ["cost", "cost"] },
            "expect": {
                "visible": ["safe_water", "main_source", "members", "children", "visit_date", "notes", "phone", "hh", "concerns", "n1", "location", "photo1"],
                "required": ["safe_water", "main_source", "members", "concerns", "photo1"],
                "answers": { "safe_water": "no", "main_source": "vendor", "members": 9 },
                "errors": { "concerns": "type", "photo1": "required" }
            }
        },
        {
            "name": "empty list, empty string and null are all unanswered",
            "form": "wash", "today": "2026-11-15",
            "answers": { "safe_water": "", "members": 6, "concerns": [], "location": null },
            "expect": {
                "visible": ["safe_water", "members", "children", "visit_date", "notes", "phone", "hh", "concerns", "n1", "location", "photo1"],
                "required": ["safe_water", "members", "concerns"],
                "answers": { "members": 6 },
                "errors": { "safe_water": "required", "concerns": "required" }
            }
        },
        {
            "name": "yes/no takes only yes or no; booleans are refused",
            "form": "wash", "today": "2026-11-15", "answers": { "safe_water": true, "members": 1 },
            "expect": {
                "visible": ["safe_water", "members", "visit_date", "notes", "phone", "location", "photo1"],
                "required": ["safe_water", "members"],
                "answers": { "members": 1 },
                "errors": { "safe_water": "type" }
            }
        },
        {
            "name": "a location with accuracy",
            "form": "wash", "today": "2026-11-15",
            "answers": { "safe_water": "yes", "members": 1, "location": { "lat": 4.8594, "lng": 31.5713, "accuracy": 12.5 } },
            "expect": {
                "visible": ["safe_water", "members", "visit_date", "notes", "phone", "location", "photo1"],
