{
    "$comment": "Conformance cases for the data collection rules engine (ADR-0012 §4). Both engines run every case: project-management/app/Collect/Rules.php (tests/Unit/Mel/CollectRulesTest.php) and project-management/resources/js/mel/collect/rules.ts (rules.test.ts), and later the field app's copy. expect.visible and expect.required are in document order. Add a case here, never to one engine only.",
    "forms": {
        "wash": {
            "schema_version": 1,
            "settings": { "title": "WASH household survey" },
            "items": [
                { "type": "yes_no", "name": "safe_water", "label": "Safe drinking water?", "required": true },
                { "type": "select_one", "name": "main_source", "label": "Main source", "choices": "sources", "required": true,
                  "relevant": { "q": "safe_water", "op": "eq", "value": "no" } },
                { "type": "integer", "name": "members", "label": "People", "required": true, "constraint": { "min": 1, "max": 50 } },
                { "type": "integer", "name": "children", "label": "Children", "constraint": { "max": 49 },
                  "relevant": { "q": "members", "op": "gte", "value": 2 } },
                { "type": "date", "name": "visit_date", "label": "Visit date", "constraint": { "min": "today-30d", "max": "today" } },
                { "type": "textarea", "name": "notes", "label": "Notes", "constraint": { "max_length": 10 } },
                { "type": "text", "name": "phone", "label": "Phone", "constraint": { "pattern": "phone" } },
                { "type": "group", "name": "hh", "label": "Household needs",
                  "relevant": { "any": [ { "q": "members", "op": "gt", "value": 5 }, { "q": "safe_water", "op": "eq", "value": "no" } ] },
                  "items": [
                      { "type": "select_multiple", "name": "concerns", "label": "Concerns", "choices": "concerns", "required": true,
                        "constraint": { "min_choices": 1, "max_choices": 2 } },
                      { "type": "note", "name": "n1", "label": "Thank the household." }
                  ] },
                { "type": "geopoint", "name": "location", "label": "Location" },
                { "type": "photo", "name": "photo1", "label": "Water point",
                  "required_if": { "q": "safe_water", "op": "eq", "value": "no" } }
            ],
            "choices": {
                "sources": [ { "name": "river", "label": "River" }, { "name": "vendor", "label": "Vendor" }, { "name": "borehole", "label": "Borehole" } ],
                "concerns": [ { "name": "cost", "label": "Cost" }, { "name": "distance", "label": "Distance" }, { "name": "quality", "label": "Quality" } ]
            }
        },
        "ops": {
            "schema_version": 1,
            "settings": { "title": "Operators" },
            "items": [
                { "type": "integer", "name": "n", "label": "n" },
                { "type": "decimal", "name": "d", "label": "d" },
                { "type": "select_one", "name": "s", "label": "s", "choices": "abc" },
                { "type": "select_multiple", "name": "m", "label": "m", "choices": "abc" },
                { "type": "text", "name": "t", "label": "t" },
                { "type": "date", "name": "dt", "label": "dt" },
                { "type": "time", "name": "tm", "label": "tm" },
                { "type": "datetime", "name": "dtm", "label": "dtm" },
                { "type": "yes_no", "name": "y", "label": "y" },
                { "type": "note", "name": "n_gt5", "label": ".", "relevant": { "q": "n", "op": "gt", "value": 5 } },
                { "type": "note", "name": "n_ne5", "label": ".", "relevant": { "q": "n", "op": "ne", "value": 5 } },
                { "type": "note", "name": "n_eq5f", "label": ".", "relevant": { "q": "n", "op": "eq", "value": 5.0 } },
                { "type": "note", "name": "d_lte", "label": ".", "relevant": { "q": "d", "op": "lte", "value": 2.5 } },
                { "type": "note", "name": "s_in", "label": ".", "relevant": { "q": "s", "op": "in", "value": ["a", "b"] } },
                { "type": "note", "name": "s_eq_c", "label": ".", "relevant": { "q": "s", "op": "eq", "value": "c" } },
                { "type": "note", "name": "m_inc", "label": ".", "relevant": { "q": "m", "op": "includes", "value": "b" } },
                { "type": "note", "name": "t_eq", "label": ".", "relevant": { "q": "t", "op": "eq", "value": "Juba" } },
                { "type": "note", "name": "t_num", "label": ".", "relevant": { "q": "t", "op": "eq", "value": 5 } },
                { "type": "note", "name": "dt_lt", "label": ".", "relevant": { "q": "dt", "op": "lt", "value": "2026-06-01" } },
                { "type": "note", "name": "tm_gte", "label": ".", "relevant": { "q": "tm", "op": "gte", "value": "08:30" } },
                { "type": "note", "name": "dtm_gt", "label": ".", "relevant": { "q": "dtm", "op": "gt", "value": "2026-01-01T12:00" } },
                { "type": "note", "name": "y_ne", "label": ".", "relevant": { "q": "y", "op": "ne", "value": "yes" } },
                { "type": "note", "name": "n_ans", "label": ".", "relevant": { "q": "n", "op": "answered" } },
                { "type": "note", "name": "n_not", "label": ".", "relevant": { "q": "n", "op": "not_answered" } },
                { "type": "note", "name": "not_any", "label": ".",
                  "relevant": { "not": { "any": [ { "q": "n", "op": "gt", "value": 5 }, { "q": "y", "op": "eq", "value": "yes" } ] } } },
                { "type": "note", "name": "always", "label": ".", "relevant": { "all": [] } },
                { "type": "note", "name": "never", "label": ".", "relevant": { "any": [] } }
            ],
            "choices": { "abc": [ { "name": "a", "label": "A" }, { "name": "b", "label": "B" }, { "name": "c", "label": "C" } ] }
        },
        "chain": {
            "schema_version": 1,
            "settings": { "title": "Chained visibility" },
            "items": [
                { "type": "yes_no", "name": "a", "label": "a" },
                { "type": "text", "name": "b", "label": "b", "relevant": { "q": "a", "op": "eq", "value": "yes" } },
                { "type": "text", "name": "c", "label": "c", "relevant": { "q": "b", "op": "answered" } },
                { "type": "group", "name": "g", "label": "g", "relevant": { "q": "a", "op": "eq", "value": "yes" },
                  "items": [ { "type": "integer", "name": "d", "label": "d", "required": true } ] },
                { "type": "integer", "name": "e", "label": "e", "required_if": { "q": "d", "op": "gt", "value": 10 } }
            ],
            "choices": {}
        },
        "times": {
            "schema_version": 1,
            "settings": { "title": "Times" },
            "items": [
                { "type": "datetime", "name": "dt", "label": "dt", "constraint": { "min": "today-1d", "max": "today" } },
                { "type": "time", "name": "tm", "label": "tm", "constraint": { "min": "06:00", "max": "18:00" } }
            ],
            "choices": {}
        }
    },
    "cases": [
        {
            "name": "nothing answered: required questions report, conditional ones stay hidden",
            "form": "wash", "today": "2026-11-15", "answers": {},
            "expect": {
                "visible": ["safe_water", "members", "visit_date", "notes", "phone", "location", "photo1"],
                "required": ["safe_water", "members"],
                "answers": {},
                "errors": { "safe_water": "required", "members": "required" }
            }
        },
        {
            "name": "a valid short household",
            "form": "wash", "today": "2026-11-15", "answers": { "safe_water": "yes", "members": 3 },
            "expect": {
                "visible": ["safe_water", "members", "children", "visit_date", "notes", "phone", "location", "photo1"],
                "required": ["safe_water", "members"],
                "answers": { "safe_water": "yes", "members": 3 },
                "errors": {}
            }
        },
        {
            "name": "no safe water opens the follow-up, the section and the photo",
            "form": "wash", "today": "2026-11-15",
            "answers": { "safe_water": "no", "main_source": "river", "members": 7, "concerns": ["cost"],
                         "photo1": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08" },
            "expect": {
                "visible": ["safe_water", "main_source", "members", "children", "visit_date", "notes", "phone", "hh", "concerns", "n1", "location", "photo1"],
                "required": ["safe_water", "main_source", "members", "concerns", "photo1"],
                "answers": { "safe_water": "no", "main_source": "river", "members": 7, "concerns": ["cost"],
                             "photo1": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08" },
                "errors": {}
            }
        },
        {
            "name": "a hidden question's answer and unknown names are dropped, not validated",
            "form": "wash", "today": "2026-11-15",
            "answers": { "safe_water": "yes", "main_source": "lake", "members": 2, "zzz": "anything", "concerns": "bad" },
            "expect": {
                "visible": ["safe_water", "members", "children", "visit_date", "notes", "phone", "location", "photo1"],
                "required": ["safe_water", "members"],
                "answers": { "safe_water": "yes", "members": 2 },
                "errors": {}
            }
        },
        {
            "name": "an invalid answer is an error and counts as unanswered for later rules",
            "form": "wash", "today": "2026-11-15", "answers": { "safe_water": "yes", "members": "3" },
            "expect": {
                "visible": ["safe_water", "members", "visit_date", "notes", "phone", "location", "photo1"],
                "required": ["safe_water", "members"],
                "answers": { "safe_water": "yes" },
                "errors": { "members": "type" }
            }
        },
        {
            "name": "integers: fractions refused, a whole decimal accepted",
            "form": "wash", "today": "2026-11-15", "answers": { "safe_water": "yes", "members": 3.0, "children": 1.5 },
            "expect": {
                "visible": ["safe_water", "members", "children", "visit_date", "notes", "phone", "location", "photo1"],
                "required": ["safe_water", "members"],
                "answers": { "safe_water": "yes", "members": 3 },
                "errors": { "children": "type" }
            }
        },
        {
            "name": "numeric minimum",
            "form": "wash", "today": "2026-11-15", "answers": { "safe_water": "yes", "members": 0 },
