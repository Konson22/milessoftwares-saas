            "form": "times", "today": "2026-03-01", "answers": { "dt": "2026-03-01T24:00", "tm": "18:01" },
            "expect": {
                "visible": ["dt", "tm"], "required": [], "answers": {},
                "errors": { "dt": "type", "tm": "max" }
            }
        },
        {
            "name": "relative bounds cross a leap day",
            "form": "times", "today": "2024-03-01", "answers": { "dt": "2024-02-29T00:00" },
            "expect": {
                "visible": ["dt", "tm"], "required": [], "answers": { "dt": "2024-02-29T00:00" }, "errors": {}
