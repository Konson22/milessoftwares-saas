                "visible": ["safe_water", "members", "visit_date", "notes", "phone", "location", "photo1"],
                "required": ["safe_water", "members"],
                "answers": { "safe_water": "yes", "members": 1 },
                "errors": { "location": "type" }
            }
        },
        {
            "name": "operators with nothing answered: only presence tests and negations hold",
            "form": "ops", "today": "2026-11-15", "answers": {},
            "expect": {
                "visible": ["n", "d", "s", "m", "t", "dt", "tm", "dtm", "y", "n_not", "not_any", "always"],
                "required": [], "answers": {}, "errors": {}
            }
        },
        {
            "name": "operators, first set",
            "form": "ops", "today": "2026-11-15",
            "answers": { "n": 6, "d": 2.5, "s": "a", "m": ["b", "c"], "t": "Juba", "dt": "2026-05-31", "tm": "08:30", "dtm": "2026-01-01T12:01", "y": "no" },
            "expect": {
                "visible": ["n", "d", "s", "m", "t", "dt", "tm", "dtm", "y", "n_gt5", "n_ne5", "d_lte", "s_in", "m_inc", "t_eq", "dt_lt", "tm_gte", "dtm_gt", "y_ne", "n_ans", "always"],
                "required": [],
                "answers": { "n": 6, "d": 2.5, "s": "a", "m": ["b", "c"], "t": "Juba", "dt": "2026-05-31", "tm": "08:30", "dtm": "2026-01-01T12:01", "y": "no" },
                "errors": {}
