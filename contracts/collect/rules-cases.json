                "answers": { "safe_water": "yes", "members": 1, "visit_date": "2026-10-16", "notes": "😀😀😀😀😀😀😀😀😀😀", "phone": "+211 912 345" },
                "errors": {}
            }
        },
        {
            "name": "an impossible date, text too long, a bad phone number",
            "form": "wash", "today": "2026-11-15",
            "answers": { "safe_water": "yes", "members": 1, "visit_date": "2026-02-30", "notes": "ééééééééééé", "phone": "abc" },
            "expect": {
                "visible": ["safe_water", "members", "visit_date", "notes", "phone", "location", "photo1"],
                "required": ["safe_water", "members"],
                "answers": { "safe_water": "yes", "members": 1 },
                "errors": { "visit_date": "type", "notes": "max_length", "phone": "pattern" }
            }
        },
        {
            "name": "a choice not in the list; too many choices",
            "form": "wash", "today": "2026-11-15",
