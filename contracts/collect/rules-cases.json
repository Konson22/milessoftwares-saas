                "answers": { "safe_water": "yes", "members": 1 },
                "errors": { "visit_date": "max" }
            }
        },
        {
            "name": "date more than 30 days ago",
            "form": "wash", "today": "2026-11-15", "answers": { "safe_water": "yes", "members": 1, "visit_date": "2026-10-15" },
            "expect": {
                "visible": ["safe_water", "members", "visit_date", "notes", "phone", "location", "photo1"],
                "required": ["safe_water", "members"],
                "answers": { "safe_water": "yes", "members": 1 },
                "errors": { "visit_date": "min" }
            }
        },
        {
            "name": "date exactly 30 days ago, short text in code points, a phone number",
            "form": "wash", "today": "2026-11-15",
            "answers": { "safe_water": "yes", "members": 1, "visit_date": "2026-10-16", "notes": "😀😀😀😀😀😀😀😀😀😀", "phone": "+211 912 345" },
            "expect": {
                "visible": ["safe_water", "members", "visit_date", "notes", "phone", "location", "photo1"],
