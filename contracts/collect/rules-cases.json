                "answers": { "safe_water": "yes" },
                "errors": { "members": "min" }
            }
        },
        {
            "name": "numeric maximums",
            "form": "wash", "today": "2026-11-15", "answers": { "safe_water": "yes", "members": 3, "children": 50 },
            "expect": {
                "visible": ["safe_water", "members", "children", "visit_date", "notes", "phone", "location", "photo1"],
                "required": ["safe_water", "members"],
                "answers": { "safe_water": "yes", "members": 3 },
                "errors": { "children": "max" }
            }
        },
        {
            "name": "date after today",
            "form": "wash", "today": "2026-11-15", "answers": { "safe_water": "yes", "members": 1, "visit_date": "2026-11-16" },
            "expect": {
                "visible": ["safe_water", "members", "visit_date", "notes", "phone", "location", "photo1"],
