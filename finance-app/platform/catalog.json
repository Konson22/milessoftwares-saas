    "separation_of_duties": [
        {
            "permissions": [
                "finance.payments.prepare",
                "finance.payments.approve"
            ],
            "mode": "warn",
            "description": "One person both requesting and approving payments removes the second check."
        },
        {
            "permissions": [
                "finance.payments.review",
                "finance.payments.approve"
            ],
            "mode": "warn",
            "description": "Review and approval are meant to be two different checks."
        },
        {
            "permissions": [
                "finance.payments.approve",
                "finance.payments.disburse"
            ],
            "mode": "warn",
            "description": "One person both approving and releasing money removes the second check."
        },
        {
            "permissions": [
                "finance.payments.prepare",
                "finance.payments.disburse"
            ],
            "mode": "warn",
            "description": "One person both requesting and releasing money should not handle the same payment."
        },
        {
            "permissions": ["finance.bills.manage", "finance.payments.approve"],
            "mode": "warn",
            "description": "Recording a bill and approving its payment lets one person create and clear a debt."
        },
        {
            "permissions": [
                "finance.payments.disburse",
                "finance.banking.reconcile"
            ],
            "mode": "warn",
            "description": "Whoever releases money should not also reconcile the account it left."
        },
        {
            "permissions": [
                "finance.payments.disburse",
                "finance.journals.post"
            ],
            "mode": "warn",
            "description": "Whoever releases money should not also be able to post entries that hide it."
        },
        {
            "permissions": [
                "finance.payments.approve",
                "finance.journals.approve"
            ],
            "mode": "warn",
            "description": "One person approving both payments and journals controls both sides of an entry."
        },
        {
            "permissions": [
                "finance.approvals.configure",
                "finance.payments.approve"
            ],
            "mode": "warn",
            "description": "An approver who sets the approval rules can switch off the check on themselves."
        },
        {
            "permissions": [
                "finance.approvals.configure",
                "finance.journals.approve"
            ],
            "mode": "warn",
            "description": "An approver who sets the approval rules can switch off the check on themselves."
        }
    ]
