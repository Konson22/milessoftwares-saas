<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Tests run without a .env (CI, fresh checkouts). -->
        <env name="APP_KEY" value="base64:zAz3VeBVw6dJf38H1eOTUJZDncmf+la9sJA5thlzARA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- A fixed platform for tests: InteractsWithPlatform fakes its API. -->
        <env name="PLATFORM_APPLICATION" value="finance"/>
        <env name="PLATFORM_ROOT_DOMAIN" value="milessoftwares.test"/>
        <env name="PLATFORM_ISSUER" value="https://auth.milessoftwares.test"/>
        <env name="PLATFORM_BACKCHANNEL_URL" value=""/>
        <env name="PLATFORM_SIGN_IN_CLIENT_ID" value="test-sign-in-client"/>
        <env name="PLATFORM_SIGN_IN_CLIENT_SECRET" value="test-sign-in-secret"/>
        <env name="PLATFORM_SERVICE_CLIENT_ID" value="test-service-client"/>
        <env name="PLATFORM_SERVICE_CLIENT_SECRET" value="test-service-secret"/>
        <env name="PLATFORM_WEBHOOK_SECRET" value="whsec_test"/>
        <env name="SESSION_PATH" value="/"/>
        <env name="TRUSTED_PROXIES" value=""/>
    </php>
</phpunit>
