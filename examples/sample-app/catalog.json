{
    "application": {
        "code": "sample",
        "name": "Sample product",
        "category": "examples",
        "kind": "standalone",
        "status": "beta"
    },
    "version": "1.0.0",
    "permissions": [
        {
            "key": "sample.records.view",
            "name": "View records",
            "sensitivity": 1,
            "scopes": ["organization", "branch"]
        },
        {
            "key": "sample.records.edit",
            "name": "Edit records",
            "sensitivity": 2,
            "scopes": ["organization", "branch"]
        }
    ],
    "roles": [
        {
            "key": "viewer",
            "name": "Viewer",
            "sensitivity": 1,
            "delegable": true,
            "scopes": ["organization", "branch"],
            "permissions": ["sample.records.view"]
        },
        {
            "key": "editor",
            "name": "Editor",
            "sensitivity": 2,
            "delegable": true,
            "scopes": ["organization", "branch"],
            "permissions": ["sample.records.view", "sample.records.edit"]
        }
    ]
}
